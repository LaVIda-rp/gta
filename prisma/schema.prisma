generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  discordId     String?   @unique
  accounts      Account[]
  sessions      Session[]
  applications  Application[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RuleCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  rules       Rule[]
  createdAt   DateTime @default(now())
}

model Rule {
  id          String       @id @default(cuid())
  title       String
  content     String
  categoryId  String
  category    RuleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
}

model FormQuestion {
  id          String   @id @default(cuid())
  question    String
  type        String   // TEXT, TEXTAREA, SELECT
  options     String?  // JSON string for SELECT options
  required    Boolean  @default(true)
  order       Int      @default(0)
  answers     ApplicationAnswer[]
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  answers   ApplicationAnswer[]
}

model ApplicationAnswer {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer        String
}

model Streamer {
  id        String   @id @default(cuid())
  name      String
  platform  String   @default("Twitch")
  avatar    String
  link      String
  isLive    Boolean  @default(false)
  viewers   Int      @default(0)
  createdAt DateTime @default(now())
}
